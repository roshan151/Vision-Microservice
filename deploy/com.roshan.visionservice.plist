<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd job for the robot vision service.

  Install:
    cp deploy/com.roshan.visionservice.plist ~/Library/LaunchAgents/
    # edit the two absolute paths below to match your checkout
    launchctl load  -w ~/Library/LaunchAgents/com.roshan.visionservice.plist

  Manage:
    launchctl list | grep visionservice        # is it running
    launchctl kickstart -k gui/$(id -u)/com.roshan.visionservice   # restart
    launchctl unload -w ~/Library/LaunchAgents/com.roshan.visionservice.plist

  A LaunchAgent (not a LaunchDaemon) is right here: it runs as you, in your GUI
  session, which is what lets it see your Python environment and use the GPU.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.roshan.visionservice</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/roshantiwari/src/Robot-Computer-Vision/vision_service/run.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/roshantiwari/src/Robot-Computer-Vision/vision_service</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>VS_BACKEND</key><string>real</string>
        <key>VS_DEVICE</key><string>mps</string>
        <key>VS_PORT</key><string>8080</string>
        <!-- Homebrew python and friends are not on launchd's default PATH. -->
        <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <!-- Restart if it exits for any reason except a clean manual unload. -->
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <!-- Back off between restarts so a crash loop does not spin the CPU. -->
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>/tmp/vision-service.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/vision-service.err.log</string>

    <!-- Models are memory-hungry; do not let launchd throttle this to a crawl. -->
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>Nice</key>
    <integer>-5</integer>
</dict>
</plist>
