# Copy to .env and uncomment what you want to change, then `make restart`.
# Plain KEY=value lines only, no quotes: both run.sh and the Makefile read this.
# Every variable and its default is listed in README.md, "Configuration".

# VS_PORT=8080
# VS_DEVICE=mps
# VS_DETECT_MODEL=yolov8n.pt
# VS_MATCH_THRESHOLD=0.45
# VS_FACE_REJECT_THRESHOLD=0.25
# VS_FACE_DET_SIZE=640
# VS_MAX_QUEUE_DEPTH=4

# Explore mode
# GEMINI_API_KEY=...
# VS_VLM_PROVIDERS=gemini,ollama
# VS_OLLAMA_MODEL=qwen3-vl:8b
# VS_PLANT_MATCH_THRESHOLD=0.62
